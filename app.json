{
  "expo": {
  "name": "Uranik's Hub",
  "slug": "uraniks-hub",
    "version": "1.4.3",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#1a1a2e"
  },
  "scheme": "uranikshub",
  "newArchEnabled": false,
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.uranik.offlinehub"
  },
  "android": {
    "package": "com.uranik.offlinehub",
      "versionCode": 47,
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "iosAccessGroup": "com.uranik.offlinehub"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "kotlinVersion": "2.1.20",
            "useLegacyPackaging": false,
            "extraProguardRules": "-keep class com.uranik.offlinehub.** { *; }"
          }
        }
      ],
      "./plugins/withFilepathsXml",
      "./plugins/withInstallPermission",
      "./plugins/withDarkSplash",
      "./plugins/withReleaseBuildConfig",
      "./plugins/withGradleProperties"
    ]
  }
}
