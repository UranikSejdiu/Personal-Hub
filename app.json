{
  "expo": {
    "name": "Personal Hub",
    "slug": "uraniks-hub",
    "version": "1.20.0",
    "orientation": "portrait",
    "icon": "./assets/icon-personal-hub.png",
    "userInterfaceStyle": "automatic",
    "scheme": "uranikshub",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uranik.offlinehub"
    },
    "android": {
      "package": "com.uranik.offlinehub",
      "versionCode": 96,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#101A35",
        "foregroundImage": "./assets/android-icon-foreground-personal-hub.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-personal-hub.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "iosAccessGroup": "com.uranik.offlinehub"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "kotlinVersion": "2.1.20",
            "useLegacyPackaging": false,
            "extraProguardRules": "-keep class com.uranik.offlinehub.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidBackupRules",
      "./plugins/withInstallPermission",
      "./plugins/withUnusedPermissions",
      "./plugins/withDarkSplash",
      "./plugins/withReleaseBuildConfig",
      "./plugins/withGradleProperties"
    ]
  }
}
