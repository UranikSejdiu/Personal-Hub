{
  "name": "uranik-android-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Budget, Notes, Tasks, and Dhikr Android apps",
  "scripts": {
    "validate": "npm run check:releases && node scripts/run-app-checks.cjs",
    "check:releases": "node scripts/check-releases.cjs",
    "version:bump": "node scripts/app-versions.cjs",
    "install:apps": "node scripts/run-app-checks.cjs install",
    "qa:emulator:build": "node scripts/emulator-preview.cjs",
    "qa:emulator:smoke": "node scripts/emulator-qa.cjs",
    "qa:emulator": "npm run validate && npm run qa:emulator:build && npm run qa:emulator:smoke",
    "budget": "npm --prefix apps/budget start",
    "notes": "npm --prefix apps/notes start",
    "tasks": "npm --prefix apps/tasks start",
    "dhikr": "npm --prefix apps/dhikr start"
  },
  "devDependencies": { "yaml": "2.9.0" }
}
