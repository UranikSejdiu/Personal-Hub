{
  "name": "dhikr",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "audit:regression": "node scripts/audit-regression.cjs",
    "audit:backup": "node scripts/backup-restore-check.cjs",
    "check:theme": "node scripts/theme-contrast.cjs",
    "validate": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run audit:regression && npm run audit:backup && npm run check:theme",
    "bundle:check": "expo export --platform android --platform ios --output-dir dist",
    "build:apk": "node scripts/build-apk.cjs",
    "signing:create": "node scripts/create-signing-key.cjs",
    "prebuild": "expo prebuild --no-clean --platform android --no-install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "57.0.12",
    "clsx": "2.1.1",
    "expo": "57.0.24",
    "expo-application": "57.0.3",
    "expo-constants": "57.0.19",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-intent-launcher": "57.0.1",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.22",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.21",
    "expo-splash-screen": "57.0.9",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "0.27.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-build-properties": "57.0.21",
    "typescript": "6.0.3"
  }
}
