{
  "expo": {
    "name": "Tasks",
    "slug": "tasks",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "uraniktasks",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uranik.tasks"
    },
    "android": {
      "allowBackup": true,
      "package": "com.uranik.tasks",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#5e37b9",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Urbanist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Urbanist-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Urbanist-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Urbanist-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Urbanist-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Urbanist-Regular.ttf",
              "./assets/fonts/Urbanist-Medium.ttf",
              "./assets/fonts/Urbanist-SemiBold.ttf",
              "./assets/fonts/Urbanist-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification.png",
          "color": "#5e37b9"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "iosAccessGroup": "com.uranik.tasks"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 37,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "useLegacyPackaging": false,
            "extraProguardRules": "-keep class com.uranik.tasks.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidBackupRules",
      "./plugins/withInstallPermission",
      "./plugins/withUnusedPermissions",
      "./plugins/withDarkSplash",
      "./plugins/withGradleProperties",
      "./plugins/withReleaseSigning",
      "./plugins/withNotificationLogo",
      "./plugins/withWindowsCMakePaths"
    ]
  }
}
