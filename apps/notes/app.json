{
  "expo": {
    "name": "My Notes",
    "slug": "notes",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "uraniknotes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uranik.notes"
    },
    "android": {
      "allowBackup": true,
      "package": "com.uranik.notes",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#252824",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your notes.",
          "cameraPermission": "Take photos for your notes."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice attachments for your notes.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Urbanist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Urbanist-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Urbanist-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Urbanist-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Urbanist-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Urbanist-Regular.ttf",
              "./assets/fonts/Urbanist-Medium.ttf",
              "./assets/fonts/Urbanist-SemiBold.ttf",
              "./assets/fonts/Urbanist-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "iosAccessGroup": "com.uranik.notes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 37,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "useLegacyPackaging": false,
            "extraProguardRules": "-keep class com.uranik.notes.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidBackupRules",
      "./plugins/withInstallPermission",
      "./plugins/withUnusedPermissions",
      "./plugins/withAttachmentPermissions",
      "./plugins/withDarkSplash",
      "./plugins/withGradleProperties",
      "./plugins/withWindowsCMakePaths",
      "./plugins/withReleaseSigning"
    ]
  }
}
